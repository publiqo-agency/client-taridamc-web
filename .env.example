# Canonical public URL of the site, no trailing slash.
# WITHOUT it the whole site is noindex and robots.txt blocks everything
# (automatic protection for previews/staging). Set it in Production only.
NEXT_PUBLIC_SITE_URL=https://www.taridamc.com

# --- Measurement (Google Tag Manager) ---
# GTM container id (GTM-XXXXXXX). Production ONLY: without it the page
# renders no tag and no cookie banner, on purpose, so previews never fire
# hits at the one real GA4 property. The GA4 id (G-...) lives inside the
# container, never here. See MEASUREMENT.md.
NEXT_PUBLIC_GTM_ID=

# --- Contact form (Resend) ---
# Without RESEND_API_KEY or CONTACT_EMAIL the form dry-runs in development
# (logs the message, returns success). In production it never fakes success:
# it logs the misconfiguration and returns an error, so no lead is lost silently.
#
# Use a send-only key scoped to the agency's verified sending domain
# (web.publiqo.es). It cannot read the Resend account or send from any other domain.
RESEND_API_KEY=

# Sender. Must be on a domain verified in Resend (SPF + DKIM); web.publiqo.es
# is. The sandbox onboarding@resend.dev ONLY delivers to the Resend account owner.
RESEND_FROM="Web <taridamc@web.publiqo.es>"

# Inbox that receives the form messages. Each notification's Reply-To is the
# visitor's address, so answering the email answers the person.
CONTACT_EMAIL=
